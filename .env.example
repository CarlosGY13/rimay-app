# Copia este archivo a .env y ajusta los valores si hace falta:
#   cp .env.example .env

# ---- Postgres ----
POSTGRES_USER=rimay
POSTGRES_PASSWORD=rimay_local_password
POSTGRES_DB=rimay
# Puerto expuesto en localhost para inspeccionar la DB con un cliente.
POSTGRES_PORT=5432

# ---- App ----
# Puerto en el que la app queda expuesta en el host.
APP_PORT=3000

# ---- Conexión a la base de datos ----
# El host "postgres" es el nombre del servicio en docker-compose (red interna).
# Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB de arriba.
# Aún no se usa desde el código: la Tarea 2 (persistencia) la consumirá.
DATABASE_URL=postgresql://rimay:rimay_local_password@postgres:5432/rimay
