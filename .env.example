# Copia este archivo a .env y ajusta los valores si hace falta:
#   cp .env.example .env

# ---- Postgres ----
POSTGRES_USER=rimay
POSTGRES_PASSWORD=rimay_local_password
POSTGRES_DB=rimay
# Puerto expuesto en localhost para inspeccionar la DB con un cliente.
POSTGRES_PORT=5432

# ---- App ----
# Puerto en el que la app queda expuesta en el host.
APP_PORT=3000

# ---- Conexión a la base de datos ----
# Esta URL la usan las herramientas locales (Prisma CLI, migraciones, seed) y
# la app cuando corre en el host con `npm run dev`. Apunta a "localhost" porque
# Postgres expone el 5432 en tu máquina.
#
# OJO: dentro de docker-compose, el servicio `app` NO usa este valor: arma su
# propia URL con host "postgres" (el nombre del servicio en la red interna de
# Docker) a partir de POSTGRES_USER/PASSWORD/DB. Ver docker-compose.yml.
DATABASE_URL=postgresql://rimay:rimay_local_password@localhost:5432/rimay

# ---- Proveedor de IA ----
# Selecciona el adaptador de IA: "openai" o "gemini".
AI_PROVIDER=openai
# API keys (colocá las tuyas; nunca subas keys reales al repo).
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
# Modelos (opcionales; hay defaults razonables si se dejan vacíos).
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# ---- Sesión (Tarea 7) ----
# Secreto para firmar los JWT de sesión. Generá una cadena larga y aleatoria
# (mínimo 16 caracteres). Cambiala en producción.
SESSION_SECRET=change-me-long-random-session-secret

# ---- Telegram (opcional) ----
# Token del bot creado con @BotFather.
TELEGRAM_BOT_TOKEN=
# Cadena aleatoria para validar el webhook (Telegram la reenvía en un header).
TELEGRAM_WEBHOOK_SECRET=change-me-random-telegram-secret
